<%- include('layout', {
  title: 'Dashboard',
  body: `
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Channel Dashboard</h2>
      <a href="/upload" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Upload Video
      </a>
    </div>

    <div class="row mb-4" id="stats-container">
      <div class="col-12 text-center">
        <div class="spinner-border" role="status">
          <span class="visually-hidden">Loading stats...</span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Your Videos</h5>
        <div class="d-flex gap-2">
          <select class="form-select form-select-sm" id="sortBy">
            <option value="createdAt">Upload Date</option>
            <option value="views">Views</option>
            <option value="title">Title</option>
          </select>
          <select class="form-select form-select-sm" id="sortType">
            <option value="desc">Descending</option>
            <option value="asc">Ascending</option>
          </select>
        </div>
      </div>
      <div class="card-body">
        <div id="videos-container">
          <div class="text-center">
            <div class="spinner-border" role="status">
              <span class="visually-hidden">Loading videos...</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="editVideoModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Edit Video</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <form id="editVideoForm">
              <input type="hidden" id="editVideoId">
              <div class="mb-3">
                <label class="form-label">Title</label>
                <input type="text" class="form-control" id="editTitle" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" id="editDescription" rows="4"></textarea>
              </div>
              <div class="mb-3">
                <label class="form-label">New Thumbnail (optional)</label>
                <input type="file" class="form-control" id="editThumbnail" accept="image/*">
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="saveVideoChanges()">Save Changes</button>
          </div>
        </div>
      </div>
    </div>

    <script>
      let currentVideos = [];

      // Load channel stats
      async function loadStats() {
        try {
          const response = await api.get('/api/v1/dashboard/stats');
          const stats = response.data;

          document.getElementById('stats-container').innerHTML = 
            '<div class="col-md-3">' +
              '<div class="card bg-primary text-white">' +
                '<div class="card-body text-center">' +
                  '<h3>' + (stats.totalVideos || 0) + '</h3>' +
                  '<p class="mb-0">Total Videos</p>' +
                '</div>' +
              '</div>' +
            '</div>' +
            '<div class="col-md-3">' +
              '<div class="card bg-success text-white">' +
                '<div class="card-body text-center">' +
                  '<h3>' + (stats.totalViews || 0) + '</h3>' +
                  '<p class="mb-0">Total Views</p>' +
                '</div>' +
              '</div>' +
            '</div>' +
            '<div class="col-md-3">' +
              '<div class="card bg-info text-white">' +
                '<div class="card-body text-center">' +
                  '<h3>' + (stats.totalSubscribers || 0) + '</h3>' +
                  '<p class="mb-0">Subscribers</p>' +
                '</div>' +
              '</div>' +
            '</div>' +
            '<div class="col-md-3">' +
              '<div class="card bg-warning text-white">' +
                '<div class="card-body text-center">' +
                  '<h3>' + (stats.totalLikes || 0) + '</h3>' +
                  '<p class="mb-0">Total Likes</p>' +
                '</div>' +
              '</div>' +
            '</div>';
        } catch (error) {
          console.error('Error loading stats:', error);
          document.getElementById('stats-container').innerHTML = 
            '<div class="col-12">' +
              '<div class="alert alert-danger">Error loading statistics</div>' +
            '</div>';
        }
      }

      // Load channel videos
      async function loadVideos() {
        try {
          const sortBy = document.getElementById('sortBy').value;
          const sortType = document.getElementById('sortType').value;

          const response = await api.get('/api/v1/dashboard/videos?sortBy=' + sortBy + '&sortType=' + sortType + '&limit=20');
          currentVideos = response.data.videos || [];

          if (currentVideos.length === 0) {
            document.getElementById('videos-container').innerHTML = 
              '<div class="text-center py-4">' +
                '<i class="fas fa-video fa-3x text-muted mb-3"></i>' +
                '<h5>No videos uploaded yet</h5>' +
                '<p class="text-muted">Start creating content by uploading your first video!</p>' +
                '<a href="/upload" class="btn btn-primary">Upload Video</a>' +
              '</div>';
            return;
          }

          let tableHTML = 
            '<div class="table-responsive">' +
              '<table class="table table-hover">' +
                '<thead>' +
                  '<tr>' +
                    '<th>Video</th>' +
                    '<th>Status</th>' +
                    '<th>Views</th>' +
                    '<th>Likes</th>' +
                    '<th>Comments</th>' +
                    '<th>Uploaded</th>' +
                    '<th>Actions</th>' +
                  '</tr>' +
                '</thead>' +
                '<tbody>';

          currentVideos.forEach(video => {
            tableHTML += 
              '<tr>' +
                '<td>' +
                  '<div class="d-flex align-items-center">' +
                    '<img src="' + video.thumbnail + '" class="me-3 rounded" width="80" height="45" style="object-fit: cover;">' +
                    '<div>' +
                      '<h6 class="mb-0">' + video.title + '</h6>' +
                      '<small class="text-muted">' + (video.description ? video.description.substring(0, 50) : 'No description') + '...</small>' +
                    '</div>' +
                  '</div>' +
                '</td>' +
                '<td>' +
                  '<span class="badge ' + (video.isPublished ? 'bg-success' : 'bg-secondary') + '">' +
                    (video.isPublished ? 'Published' : 'Draft') +
                  '</span>' +
                '</td>' +
                '<td>' + (video.views || 0) + '</td>' +
                '<td>' + (video.likesCount || 0) + '</td>' +
                '<td>' + (video.commentsCount || 0) + '</td>' +
                '<td>' + new Date(video.createdAt).toLocaleDateString() + '</td>' +
                '<td>' +
                  '<div class="btn-group btn-group-sm">' +
                    '<a href="/watch/' + video._id + '" class="btn btn-outline-primary" title="View">' +
                      '<i class="fas fa-eye"></i>' +
                    '</a>' +
                    '<button class="btn btn-outline-secondary" onclick="editVideo(\'' + video._id + '\')" title="Edit">' +
                      '<i class="fas fa-edit"></i>' +
                    '</button>' +
                    '<button class="btn btn-outline-warning" onclick="togglePublish(\'' + video._id + '\', ' + video.isPublished + ')" title="Toggle Status">' +
                      '<i class="fas ' + (video.isPublished ? 'fa-eye-slash' : 'fa-eye') + '"></i>' +
                    '</button>' +
                    '<button class="btn btn-outline-danger" onclick="deleteVideo(\'' + video._id + '\')" title="Delete">' +
                      '<i class="fas fa-trash"></i>' +
                    '</button>' +
                  '</div>' +
                '</td>' +
              '</tr>';
          });

          tableHTML += 
                '</tbody>' +
              '</table>' +
            '</div>';

          document.getElementById('videos-container').innerHTML = tableHTML;
        } catch (error) {
          console.error('Error loading videos:', error);
          document.getElementById('videos-container').innerHTML = 
            '<div class="alert alert-danger">Error loading videos</div>';
        }
      }

      // Edit video
      function editVideo(videoId) {
        const video = currentVideos.find(v => v._id === videoId);
        if (!video) return;

        document.getElementById('editVideoId').value = videoId;
        document.getElementById('editTitle').value = video.title;
        document.getElementById('editDescription').value = video.description || '';

        new bootstrap.Modal(document.getElementById('editVideoModal')).show();
      }

      // Save video changes
      async function saveVideoChanges() {
        const videoId = document.getElementById('editVideoId').value;
        const title = document.getElementById('editTitle').value;
        const description = document.getElementById('editDescription').value;
        const thumbnail = document.getElementById('editThumbnail').files[0];

        try {
          const formData = new FormData();
          formData.append('title', title);
          formData.append('description', description);
          if (thumbnail) {
            formData.append('thumbnail', thumbnail);
          }

          const response = await fetch('/api/v1/videos/' + videoId, {
            method: 'PATCH',
            credentials: 'include',
            body: formData
          });

          if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById('editVideoModal')).hide();
            loadVideos(); // Reload videos
          } else {
            alert('Error updating video');
          }
        } catch (error) {
          console.error('Error updating video:', error);
          alert('Error updating video');
        }
      }

      // Toggle publish status
      async function togglePublish(videoId, currentStatus) {
        try {
          await fetch('/api/v1/videos/toggle/publish/' + videoId, {
            method: 'PATCH',
            credentials: 'include'
          });
          loadVideos(); // Reload videos
        } catch (error) {
          console.error('Error toggling publish status:', error);
          alert('Error updating video status');
        }
      }

      // Delete video
      async function deleteVideo(videoId) {
        if (!confirm('Are you sure you want to delete this video? This action cannot be undone.')) {
          return;
        }

        try {
          await api.delete('/api/v1/videos/' + videoId);
          loadVideos(); // Reload videos
          loadStats(); // Reload stats
        } catch (error) {
          console.error('Error deleting video:', error);
          alert('Error deleting video');
        }
      }

      // Sort change handlers
      document.getElementById('sortBy').addEventListener('change', loadVideos);
      document.getElementById('sortType').addEventListener('change', loadVideos);

      // Initialize
      document.addEventListener('DOMContentLoaded', () => {
        loadStats();
        loadVideos();
      });
    </script>
  `
}) %>