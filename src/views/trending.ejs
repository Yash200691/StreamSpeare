<%- include('layout', { 
  title: 'Trending', 
  body: `
    <div class="mb-4">
      <h3><i class="fas fa-fire text-danger me-2"></i>Trending Videos</h3>
      <p class="text-muted">Popular videos on VideoTube</p>
    </div>

    <div id="trending-videos">
      <div class="text-center">
        <div class="spinner-border" role="status">
          <span class="visually-hidden">Loading trending videos...</span>
        </div>
      </div>
    </div>

    <script>
      async function loadTrendingVideos() {
        try {
          // Check if API is available
          if (typeof api === 'undefined') {
            console.error('API not available');
            document.getElementById('trending-videos').innerHTML = 
              '<div class="alert alert-danger">' +
                '<i class="fas fa-exclamation-triangle me-2"></i>' +
                'Error: API not available. Please refresh the page.' +
              '</div>';
            return;
          }

          // Load videos sorted by views (trending)
          const response = await api.get('/api/v1/videos?sortBy=views&sortType=desc&limit=24');
          const videos = response.data?.data || response.data || [];

          if (!Array.isArray(videos) || videos.length === 0) {
            document.getElementById('trending-videos').innerHTML = 
              '<div class="text-center py-5">' +
                '<i class="fas fa-fire fa-3x text-muted mb-3"></i>' +
                '<h4>No trending videos</h4>' +
                '<p class="text-muted">Check back later for popular content</p>' +
              '</div>';
            return;
          }

          document.getElementById('trending-videos').innerHTML = 
            '<div class="row">' +
              videos.map(function(video, index) {
                return '<div class="col-12 mb-4">' +
                  '<div class="card shadow-sm">' +
                    '<div class="row g-0">' +
                      '<div class="col-md-4">' +
                        '<a href="/watch/' + video._id + '">' +
                          '<img src="' + video.thumbnail + '" class="img-fluid rounded-start h-100" style="object-fit: cover; min-height: 200px;" alt="thumbnail">' +
                        '</a>' +
                      '</div>' +
                      '<div class="col-md-8">' +
                        '<div class="card-body">' +
                          '<div class="d-flex align-items-start">' +
                            '<span class="badge bg-danger me-3 fs-6">#' + (index + 1) + '</span>' +
                            '<div class="flex-grow-1">' +
                              '<h5 class="card-title">' +
                                '<a href="/watch/' + video._id + '" class="text-decoration-none text-dark">' +
                                  video.title +
                                '</a>' +
                              '</h5>' +
                              '<p class="card-text">' +
                                (video.description ? video.description.substring(0, 150) + '...' : 'No description available') +
                              '</p>' +
                              '<div class="d-flex align-items-center text-muted small">' +
                                '<img src="' + (video.owner?.avatar || '/default-avatar.png') + '" class="rounded-circle me-2" width="24" height="24" alt="channel avatar">' +
                                '<span class="me-3">' + (video.owner?.username || 'Unknown') + '</span>' +
                                '<span class="me-3">' + (video.views || 0) + ' views</span>' +
                                '<span>' + new Date(video.createdAt).toLocaleDateString() + '</span>' +
                              '</div>' +
                            '</div>' +
                          '</div>' +
                        '</div>' +
                      '</div>' +
                    '</div>' +
                  '</div>' +
                '</div>';
              }).join('') +
            '</div>';
        } catch (error) {
          console.error('Error loading trending videos:', error);
          document.getElementById('trending-videos').innerHTML = 
            '<div class="alert alert-danger">' +
              '<i class="fas fa-exclamation-triangle me-2"></i>' +
              'Error loading trending videos. Please try again.' +
              '<button class="btn btn-outline-danger btn-sm ms-2" onclick="loadTrendingVideos()">Retry</button>' +
            '</div>';
        }
      }

      // Initialize on page load
      document.addEventListener('DOMContentLoaded', loadTrendingVideos);
    </script>
  `
}) %>