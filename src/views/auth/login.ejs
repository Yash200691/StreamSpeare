<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - VideoTube</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
        }
        .card {
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.9);
        }
        .brand {
            color: #dc3545;
            font-size: 2rem;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <h1 class="brand">VideoTube</h1>
                            <h4 class="mb-3">Welcome back</h4>
                        </div>
                        
                        <div id="alert-container"></div>
                        
                        <form id="loginForm" class="vstack gap-3">
                            <div>
                                <input class="form-control form-control-lg" 
                                       name="email" 
                                       type="email" 
                                       placeholder="Email" 
                                       required />
                            </div>
                            <div>
                                <input class="form-control form-control-lg" 
                                       name="password" 
                                       type="password" 
                                       placeholder="Password" 
                                       required />
                            </div>
                            <button class="btn btn-dark btn-lg" type="submit" id="loginBtn">
                                <span class="spinner-border spinner-border-sm me-2 d-none" id="loginSpinner"></span>
                                Sign in
                            </button>
                        </form>
                        
                        <p class="mt-4 text-center">
                            Don't have an account? 
                            <a href="/signup" class="text-decoration-none">Create one</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const btn = document.getElementById('loginBtn');
            const spinner = document.getElementById('loginSpinner');
            const alertContainer = document.getElementById('alert-container');
            
            // Show loading state
            btn.disabled = true;
            spinner.classList.remove('d-none');
            alertContainer.innerHTML = '';
            
            try {
                const formData = new FormData(e.target);
                const data = Object.fromEntries(formData.entries());
                
                const response = await fetch('/api/v1/users/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (response.ok) {
                    alertContainer.innerHTML = `
                        <div class="alert alert-success">Login successful! Redirecting...</div>
                    `;
                    setTimeout(() => window.location.href = '/home', 1000);
                } else {
                    alertContainer.innerHTML = `
                        <div class="alert alert-danger">${result.message || 'Login failed'}</div>
                    `;
                }
            } catch (error) {
                alertContainer.innerHTML = `
                    <div class="alert alert-danger">Network error. Please try again.</div>
                `;
            } finally {
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        });
    </script>
</body>
</html>