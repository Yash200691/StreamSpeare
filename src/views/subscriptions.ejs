<%- include('layout', { 
  title: 'Subscriptions', 
  body: `
    <div class="container mt-4">
      <h2 class="h4 mb-3">Your Subscriptions</h2>
      <div class="row" id="subscriptions-grid">
        <div class="col-12 text-center">
          <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading subscriptions...</span>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="unsubscribeModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Confirm Unsubscribe</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            Are you sure you want to unsubscribe from <span id="modalChannelName"></span>?
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmUnsubscribe">Unsubscribe</button>
          </div>
        </div>
      </div>
    </div>
  `
}) %>

<script>
async function loadSubscriptions() {
  const grid = document.getElementById('subscriptions-grid');
  try {
    const res = await api.get('/api/v1/subscriptions');
    const { data: subscriptions } = res.data;

    if (!subscriptions || subscriptions.length === 0) {
      grid.innerHTML = '<p class="text-muted text-center mt-3">You have no subscriptions yet.</p>';
      return;
    }

    grid.innerHTML = subscriptions.map(sub => {
      const channel = sub.channelId;
      if (!channel) {
          // Skip if channel data is missing
          return '';
      }
      return `
        <div class="col-md-3 mb-4">
          <div class="card">
            <a href="/channel/${channel._id}" class="text-decoration-none text-dark">
              <img src="${channel.avatar}" class="card-img-top" alt="${channel.fullName}" style="height: 150px; object-fit: cover;">
            </a>
            <div class="card-body text-center">
              <a href="/channel/${channel._id}" class="text-decoration-none text-dark">
                <h5 class="card-title text-truncate">${channel.fullName}</h5>
                <p class="card-text text-muted small">${channel.subscribersCount || 0} subscribers</p>
              </a>
              <button 
                class="btn btn-sm btn-outline-danger mt-2" 
                onclick="showUnsubscribeModal('${channel._id}', '${channel.fullName.replace(/'/g, "\\'")}')">
                Unsubscribe
              </button>
            </div>
          </div>
        </div>
      `;
    }).join('');
  } catch (error) {
    console.error('API GET error:', error);
    grid.innerHTML = '<p class="text-danger text-center mt-3">Error loading subscriptions. Please try again.</p>';
  }
}

function showUnsubscribeModal(channelId, channelName) {
  document.getElementById('modalChannelName').textContent = channelName;
  const confirmBtn = document.getElementById('confirmUnsubscribe');
  
  // Create a new event listener each time to avoid multiple calls
  confirmBtn.onclick = async function() {
    try {
      await api.delete(`/api/v1/subscriptions/c/${channelId}`);
      location.reload(); // Reload the page to show the updated list
    } catch (err) {
      console.error('Unsubscribe error:', err);
      alert('Failed to unsubscribe. Please try again.');
    }
  };
  const modal = new bootstrap.Modal(document.getElementById('unsubscribeModal'));
  modal.show();
}

document.addEventListener('DOMContentLoaded', () => {
  loadSubscriptions();
});
</script>