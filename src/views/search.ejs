<%- include('layout', { title: 'Search Results' }) %>

<div class="mb-4">
  <h3>Search Results for: "<span id="search-query"><%= query %></span>"</h3>
  <div class="d-flex gap-2 align-items-center">
    <select class="form-select" id="sortBy" style="width: auto;">
      <option value="createdAt">Upload Date</option>
      <option value="views">View Count</option>
      <option value="title">Title</option>
    </select>
    <select class="form-select" id="sortType" style="width: auto;">
      <option value="desc">Descending</option>
      <option value="asc">Ascending</option>
    </select>
    <button class="btn btn-outline-primary" onclick="searchVideos()">
      <i class="fas fa-search"></i> Search
    </button>
  </div>
</div>

<div id="search-results">
  <div class="text-center">
    <div class="spinner-border" role="status">
      <span class="visually-hidden">Searching...</span>
    </div>
  </div>
</div>

<!-- Pagination -->
<div id="pagination-container" class="mt-4"></div>

<script>
  let currentPage = 1;
  const limit = 12;
  const searchQuery = "<%= query %>";

  async function searchVideos(page = 1) {
    const sortBy = document.getElementById('sortBy').value;
    const sortType = document.getElementById('sortType').value;

    try {
      const response = await api.get(`/api/v1/videos?page=${page}&limit=${limit}&query=${encodeURIComponent(searchQuery)}&sortBy=${sortBy}&sortType=${sortType}`);
      const videos = response.data?.data || response.data || [];
      const totalVideos = response.data?.totalVideos || videos.length;
      const totalPages = Math.ceil(totalVideos / limit);

      if (videos.length === 0) {
        document.getElementById('search-results').innerHTML = `
          <div class="text-center py-5">
            <i class="fas fa-search fa-3x text-muted mb-3"></i>
            <h4>No videos found</h4>
            <p class="text-muted">Try different keywords or check your spelling</p>
          </div>
        `;
        document.getElementById('pagination-container').innerHTML = '';
        return;
      }

      document.getElementById('search-results').innerHTML = `
        <div class="row">
          ${videos.map(video => `
            <div class="col-md-6 col-lg-4 mb-4">
              <div class="card h-100 shadow-sm">
                <a href="/watch/${video._id}" class="text-decoration-none">
                  <img src="${video.thumbnail}" class="card-img-top" style="height: 200px; object-fit: cover;" alt="thumbnail">
                </a>
                <div class="card-body">
                  <h6 class="card-title">
                    <a href="/watch/${video._id}" class="text-decoration-none text-dark">
                      ${video.title}
                    </a>
                  </h6>
                  <p class="card-text small text-muted">
                    ${video.owner?.username || 'Unknown'} • ${video.views || 0} views
                  </p>
                  <p class="card-text small text-muted">
                    ${new Date(video.createdAt).toLocaleDateString()}
                  </p>
                  <p class="card-text small">
                    ${video.description ? video.description.substring(0, 100) + '...' : 'No description'}
                  </p>
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      `;

      renderPagination(page, totalPages);
      currentPage = page;

    } catch (error) {
      console.error('Search error:', error);
      document.getElementById('search-results').innerHTML = `
        <div class="alert alert-danger">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Error searching videos. Please try again.
        </div>
      `;
    }
  }

  function renderPagination(current, total) {
    if (total <= 1) {
      document.getElementById('pagination-container').innerHTML = '';
      return;
    }

    let paginationHTML = '<nav><ul class="pagination justify-content-center">';

    paginationHTML += `
      <li class="page-item ${current === 1 ? 'disabled' : ''}">
        <button class="page-link" onclick="searchVideos(${current - 1})" ${current === 1 ? 'disabled' : ''}>
          Previous
        </button>
      </li>
    `;

    const startPage = Math.max(1, current - 2);
    const endPage = Math.min(total, current + 2);

    if (startPage > 1) {
      paginationHTML += `
        <li class="page-item">
          <button class="page-link" onclick="searchVideos(1)">1</button>
        </li>
      `;
      if (startPage > 2) {
        paginationHTML += '<li class="page-item disabled"><span class="page-link">...</span></li>';
      }
    }

    for (let i = startPage; i <= endPage; i++) {
      paginationHTML += `
        <li class="page-item ${i === current ? 'active' : ''}">
          <button class="page-link" onclick="searchVideos(${i})">${i}</button>
        </li>
      `;
    }

    if (endPage < total) {
      if (endPage < total - 1) {
        paginationHTML += '<li class="page-item disabled"><span class="page-link">...</span></li>';
      }
      paginationHTML += `
        <li class="page-item">
          <button class="page-link" onclick="searchVideos(${total})">${total}</button>
        </li>
      `;
    }

    paginationHTML += `
      <li class="page-item ${current === total ? 'disabled' : ''}">
        <button class="page-link" onclick="searchVideos(${current + 1})" ${current === total ? 'disabled' : ''}>
          Next
        </button>
      </li>
    `;

    paginationHTML += '</ul></nav>';
    document.getElementById('pagination-container').innerHTML = paginationHTML;
  }

  document.getElementById('sortBy').addEventListener('change', () => searchVideos(1));
  document.getElementById('sortType').addEventListener('change', () => searchVideos(1));

  if (searchQuery.trim()) {
    searchVideos(1);
  } else {
    document.getElementById('search-results').innerHTML = `
      <div class="text-center py-5">
        <i class="fas fa-search fa-3x text-muted mb-3"></i>
        <h4>Enter a search term</h4>
        <p class="text-muted">Use the search box above to find videos</p>
      </div>
    `;
  }
</script>
