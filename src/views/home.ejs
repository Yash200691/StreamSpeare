<%- include('layout', { 
  title: 'Home', 
  body: `
    <div class="row" id="video-grid">
      <div class="col-12 text-center">
        <div class="spinner-border" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
      </div>
    </div>

    <script>
      // Wait for DOM and API to be ready
      document.addEventListener('DOMContentLoaded', function() {
        // Check if API is available
        if (typeof api === 'undefined') {
          console.error('API not available');
          document.getElementById('video-grid').innerHTML = 
            '<div class="col-12 text-center">' +
              '<p class="text-danger">Error: API not available. Please refresh the page.</p>' +
            '</div>';
          return;
        }

        // Load videos
        (async function() {
          try {
            const res = await api.get('/api/v1/videos?limit=24');
            const items = res.data?.data || res.data || [];
            const grid = document.getElementById('video-grid');
            
            if (items.length === 0) {
              grid.innerHTML = 
                '<div class="col-12 text-center">' +
                  '<p class="text-muted">No videos found</p>' +
                '</div>';
              return;
            }
            
            grid.innerHTML = items.map(function(v) {
              return '<div class="col-6 col-md-4 col-lg-3 mb-4">' +
                '<a href="/watch/' + v._id + '" class="text-decoration-none text-dark">' +
                  '<div class="card shadow-sm h-100">' +
                    '<img src="' + v.thumbnail + '" class="card-img-top" alt="thumbnail" style="height: 200px; object-fit: cover;">' +
                    '<div class="card-body">' +
                      '<h6 class="card-title text-truncate" title="' + (v.title || 'Untitled') + '">' + (v.title || 'Untitled') + '</h6>' +
                      '<p class="card-text small text-muted mb-0">' +
                        (v.owner?.username || 'Unknown') + ' • ' + (v.views || 0) + ' views' +
                      '</p>' +
                      '<p class="card-text small text-muted">' +
                        new Date(v.createdAt).toLocaleDateString() +
                      '</p>' +
                    '</div>' +
                  '</div>' +
                '</a>' +
              '</div>';
            }).join('');
          } catch (e) {
            console.error('Error loading videos:', e);
            document.getElementById('video-grid').innerHTML = 
              '<div class="col-12 text-center">' +
                '<p class="text-danger">Error loading videos. Please try again.</p>' +
                '<button class="btn btn-primary" onclick="window.location.reload()">Refresh</button>' +
              '</div>';
          }
        })();
      });
    </script>
  `
}) %>