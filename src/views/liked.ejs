<%
%>

<div class="mb-4">
  <h3>Liked Videos</h3>
  <p class="text-muted">Videos you've liked</p>
</div>

<div id="liked-videos-container">
  <div class="text-center">
    <div class="spinner-border" role="status">
      <span class="visually-hidden">Loading liked videos...</span>
    </div>
  </div>
</div>

<script>
  async function loadLikedVideos() {
    try {
      const response = await api.get('/api/v1/likes/videos');
      const likedVideos = response.data || [];

      if (likedVideos.length === 0) {
        document.getElementById('liked-videos-container').innerHTML = `
          <div class="text-center py-5">
            <i class="fas fa-thumbs-up fa-3x text-muted mb-3"></i>
            <h4>No liked videos</h4>
            <p class="text-muted">Videos you like will appear here</p>
          </div>
        `;
        return;
      }

      document.getElementById('liked-videos-container').innerHTML = `
        <div class="row">
          ${likedVideos.map(video => `
            <div class="col-md-6 col-lg-4 mb-4">
              <div class="card h-100 shadow-sm">
                <a href="/watch/${video._id}" class="text-decoration-none">
                  <img src="${video.thumbnail}" class="card-img-top" style="height: 180px; object-fit: cover;" alt="thumbnail">
                </a>
                <div class="card-body">
                  <h6 class="card-title">
                    <a href="/watch/${video._id}" class="text-decoration-none text-dark">
                      ${video.title}
                    </a>
                  </h6>
                  <p class="card-text small text-muted mb-1">
                    ${video.ownerDetails?.username || 'Unknown'} • ${video.views || 0} views
                  </p>
                  <p class="card-text small text-muted">
                    ${new Date(video.createdAt).toLocaleDateString()}
                  </p>
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      `;
    } catch (error) {
      console.error('Error loading liked videos:', error);
      document.getElementById('liked-videos-container').innerHTML = `
        <div class="alert alert-danger">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Error loading liked videos
        </div>
      `;
    }
  }

  document.addEventListener('DOMContentLoaded', loadLikedVideos);
</script>